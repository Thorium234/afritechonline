# ============================================
# Application Configuration
# ============================================
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ============================================
# JWT Configuration
# ============================================
# CRITICAL: Change in production!
# Generate strong secret: openssl rand -base64 32
# Minimum 32 characters, high entropy required
JWT_SECRET=change-me-in-production-use-strong-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINS=15
JWT_REFRESH_TTL_HOURS=168

# ============================================
# Database Configuration
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afritechonline
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5

# ============================================
# Authentication & Security
# ============================================
SEED_ADMIN_PASSWORD=SecureAdminPassword123!

# ============================================
# M-Pesa Configuration
# ============================================
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your-mpesa-passkey
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://localhost:8080/api/v1/payments/mpesa/callback

# ============================================
# MikroTik Configuration
# ============================================
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728

# ============================================
# FreeRADIUS Configuration
# ============================================
RADIUS_HOST=127.0.0.1
RADIUS_PORT=1812
RADIUS_SECRET=testing123

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60
